cabal-version: 2.4
name: stockcheck
version: 0.1.0.0
synopsis: Offline CSV stock reconciliation with exact arithmetic
build-type: Simple
license: MIT
license-file: LICENSE

executable stockcheck
  main-is: Main.hs
  other-modules: StockCheck
  build-depends: base >=4.13 && <5, containers >=0.6 && <0.8, directory >=1.3 && <1.4
  default-language: Haskell2010
  ghc-options: -Wall -Werror -O2

test-suite stockcheck-tests
  type: exitcode-stdio-1.0
  main-is: Test.hs
  other-modules: StockCheck
  build-depends: base >=4.13 && <5, containers >=0.6 && <0.8
  default-language: Haskell2010
  ghc-options: -Wall -Werror
